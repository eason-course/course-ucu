#
# Unity .gitattributes
# Merged from:
#   - https://github.com/gitattributes/gitattributes/blob/master/Unity.gitattributes
#   - https://gist.github.com/webbertakken/ff250a0d5e59a8aae961c2e509c07fbc (GameCI)
#

# Auto-detect text files, ensure consistent line endings (LF in the repo)
* text=auto

# Macros
[attr]lfs          filter=lfs diff=lfs merge=lfs -text
[attr]unity-json   eol=lf linguist-language=json
[attr]unity-yaml   merge=unityyamlmerge eol=lf linguist-language=yaml

# Source code
*.cs               text diff=csharp
*.cginc            text
*.shader           text
*.hlsl             text
*.compute          text
*.raytrace         text

# JSON-based Unity assets
*.asmdef           unity-json
*.asmref           unity-json
*.shadergraph      unity-json
*.shadersubgraph   unity-json

# UI Toolkit
*.tss              text diff=css linguist-language=css
*.uss              text diff=css linguist-language=css
*.uxml             text linguist-language=xml linguist-detectable
*.inputactions     unity-json

# YAML-based Unity assets (merged with UnityYAMLMerge)
*.anim             unity-yaml
*.asset            unity-yaml
*.brush            unity-yaml
*.controller       unity-yaml
*.flare            unity-yaml
*.fontsettings     unity-yaml
*.giparams         unity-yaml
*.guiskin          unity-yaml
*.lighting         unity-yaml
*.mask             unity-yaml
*.mat              unity-yaml
*.meta             unity-yaml
*.mixer            unity-yaml
*.overrideController unity-yaml
*.physicMaterial   unity-yaml
*.physicsMaterial2D unity-yaml
*.playable         unity-yaml
*.prefab           unity-yaml
*.preset           unity-yaml
*.renderTexture    unity-yaml
*.scenetemplate    unity-yaml
*.shadervariants   unity-yaml
*.signal           unity-yaml
*.spriteatlas      unity-yaml
*.spriteatlasv2    unity-yaml
*.terrainlayer     unity-yaml
*.unity            unity-yaml

# Exclude generated/third-party from GitHub language stats
Assets/Plugins/**            linguist-generated
Packages/packages-lock.json  linguist-generated

# ============================================================
# Git LFS — binary assets
# ============================================================

# Special binary Unity assets
*-[Nn]av[Mm]esh.asset        lfs
*-[Tt]errain.asset           lfs
*LightingData.asset          lfs
*OcclusionCullingData.asset  lfs

